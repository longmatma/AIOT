--cpu Cortex-M3
"rbs\startup_stm32f103xb.o"
"rbs\main.o"
"rbs\stm32f1xx_it.o"
"rbs\stm32f1xx_hal_msp.o"
"rbs\stm32f1xx_hal_gpio_ex.o"
"rbs\stm32f1xx_hal_spi.o"
"rbs\stm32f1xx_hal.o"
"rbs\stm32f1xx_hal_rcc.o"
"rbs\stm32f1xx_hal_rcc_ex.o"
"rbs\stm32f1xx_hal_gpio.o"
"rbs\stm32f1xx_hal_dma.o"
"rbs\stm32f1xx_hal_cortex.o"
"rbs\stm32f1xx_hal_pwr.o"
"rbs\stm32f1xx_hal_flash.o"
"rbs\stm32f1xx_hal_flash_ex.o"
"rbs\stm32f1xx_hal_exti.o"
"rbs\stm32f1xx_hal_uart.o"
"rbs\system_stm32f1xx.o"
"rbs\e22_radio.o"
"rbs\pi_bridge.o"
"rbs\crc16.o"
--strict --scatter "rbs\rbs.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "rbs.map" -o rbs\rbs.axf