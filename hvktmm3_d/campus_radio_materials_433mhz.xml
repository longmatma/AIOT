<?xml version="1.0" encoding="UTF-8"?>
<scene version="3.0.0">

    <!--
      SIONNA RT RADIO MATERIAL LIBRARY
      Target carrier: 433 MHz

      IMPORTANT:
      - Set scene.frequency = 433e6 in Python after load_scene().
      - Some ITU-R P.2040 material fits used below have nominal validity
        starting at 1 GHz. At 433 MHz, Sionna will extrapolate those fits.
      - Scattering coefficients below are engineering baseline assumptions
        for first-pass campus simulation, NOT field-calibrated measurements.
    -->

    <!-- Main reinforced-concrete / masonry building proxy -->
    <bsdf type="itu-radio-material" id="mat-building">
        <string name="type" value="concrete"/>
        <float name="thickness" value="0.20"/>
        <float name="scattering_coefficient" value="0.15"/>
        <float name="xpd_coefficient" value="0.00"/>
        <rgb name="color" value="0.55, 0.55, 0.55"/>
    </bsdf>

    <!-- Campus perimeter walls -->
    <bsdf type="itu-radio-material" id="mat-boundary-wall">
        <string name="type" value="concrete"/>
        <float name="thickness" value="0.15"/>
        <float name="scattering_coefficient" value="0.20"/>
        <float name="xpd_coefficient" value="0.00"/>
        <rgb name="color" value="0.62, 0.62, 0.62"/>
    </bsdf>

    <!-- Soil / ground under the campus -->
    <bsdf type="itu-radio-material" id="mat-ground">
        <string name="type" value="medium_dry_ground"/>
        <float name="thickness" value="0.30"/>
        <float name="scattering_coefficient" value="0.35"/>
        <float name="xpd_coefficient" value="0.00"/>
        <rgb name="color" value="0.42, 0.25, 0.10"/>
    </bsdf>

    <!-- Asphalt/paved road proxy: Sionna ITU set has no asphalt material,
         so concrete is used as a first-pass paving proxy. -->
    <bsdf type="itu-radio-material" id="mat-road">
        <string name="type" value="concrete"/>
        <float name="thickness" value="0.10"/>
        <float name="scattering_coefficient" value="0.30"/>
        <float name="xpd_coefficient" value="0.00"/>
        <rgb name="color" value="0.20, 0.20, 0.20"/>
    </bsdf>

    <!-- Tree trunks -->
    <bsdf type="itu-radio-material" id="mat-tree-trunk">
        <string name="type" value="wood"/>
        <float name="thickness" value="0.15"/>
        <float name="scattering_coefficient" value="0.25"/>
        <float name="xpd_coefficient" value="0.00"/>
        <rgb name="color" value="0.30, 0.12, 0.05"/>
    </bsdf>

    <!-- Foliage proxy: wood is used because the current geometry does not
         model a volumetric foliage medium. Higher scattering is assumed. -->
    <bsdf type="itu-radio-material" id="mat-tree-canopy">
        <string name="type" value="wood"/>
        <float name="thickness" value="0.50"/>
        <float name="scattering_coefficient" value="0.60"/>
        <float name="xpd_coefficient" value="0.10"/>
        <rgb name="color" value="0.10, 0.45, 0.12"/>
    </bsdf>

    <!-- ATM / kiosk metal enclosure proxy -->
    <bsdf type="itu-radio-material" id="mat-atm-metal">
        <string name="type" value="metal"/>
        <float name="thickness" value="0.005"/>
        <float name="scattering_coefficient" value="0.05"/>
        <float name="xpd_coefficient" value="0.00"/>
        <rgb name="color" value="0.30, 0.30, 0.34"/>
    </bsdf>

    <!-- Optional material for future sport-court meshes -->
    <bsdf type="itu-radio-material" id="mat-sports-court">
        <string name="type" value="concrete"/>
        <float name="thickness" value="0.10"/>
        <float name="scattering_coefficient" value="0.25"/>
        <float name="xpd_coefficient" value="0.00"/>
        <rgb name="color" value="0.25, 0.45, 0.35"/>
    </bsdf>

</scene>
